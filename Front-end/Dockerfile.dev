FROM node:22-alpine

WORKDIR /app

# Instala dependências primeiro (aproveitando cache de camadas)
COPY package*.json ./
RUN npm ci

# Copia o restante (será sobrescrito pelo volume em dev)
COPY . .

EXPOSE 3000

# Vite dev server com host 0.0.0.0 para ser acessível fora do container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
